page {
  background: var(--color-bg);
}

.page {
  position: relative;
  background: rgba(245, 245, 247, 0.2);
  min-height: 100vh;
  padding: 24rpx;
  padding-top: 0;
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(245, 245, 247, 0.95);
  padding: 0 24rpx;
  margin: 0 -24rpx 20rpx;
}

.tab-item {
  position: relative;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.tab-active {
  color: var(--color-primary);
  font-weight: 700;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  left: 20rpx;
  right: 20rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 14rpx;
}

/* 举报列表 */
.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-card {
  padding: 22rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}

.report-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.report-type {
  padding: 8rpx 14rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
}

.report-status {
  font-size: 24rpx;
  font-weight: 700;
}

/* 举报对象卡片（商品/用户/订单） */
.target-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.target-image-wrap {
  width: 132rpx;
  height: 132rpx;
  overflow: hidden;
  background: #ededf2;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.target-image,
.target-image-placeholder {
  width: 100%;
  height: 100%;
}

.target-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.target-image-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.34;
}

.target-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.target-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.target-meta {
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.report-reporter {
  margin-bottom: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.report-reason {
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

/* 已处理信息 */
.handle-info {
  margin-top: 14rpx;
}

.handle-divider {
  height: 1rpx;
  background: var(--color-border);
  margin-bottom: 12rpx;
}

.handle-row {
  display: flex;
  margin-bottom: 6rpx;
}

.handle-label {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  flex-shrink: 0;
}

.handle-value {
  color: var(--color-text);
  font-size: 23rpx;
}

/* 底部加载提示 */
.bottom-tip {
  padding: 28rpx 0 40rpx;
  text-align: center;
}

.bottom-tip text {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}
