<image class="page-bg" src="/assets/images/Background.jpg" mode="aspectFill" />
<view class="page">
  <!-- tab 切换 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{tabIndex === index ? 'tab-active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      <text>{{item.label}}</text>
      <view wx:if="{{item.key === 'against' && againstBadge > 0}}" class="tab-badge">{{againstBadge > 99 ? '99+' : againstBadge}}</view>
      <view wx:if="{{tabIndex === index}}" class="tab-underline"></view>
    </view>
  </view>

  <loading-state wx:if="{{loading && reports.length === 0}}" count="4" />
  <error-tip wx:elif="{{!loading && errorMsg && reports.length === 0}}" message="{{errorMsg}}" bind:retry="onRetry" />

  <view wx:elif="{{reports.length > 0}}" class="report-list">
    <view class="report-card" wx:for="{{reports}}" wx:key="id">
      <!-- 顶部：类型标签 + 状态 -->
      <view class="report-top">
        <view class="report-type">{{item.targetTypeText}}</view>
        <view class="report-status" style="color: {{item.statusColor}}">{{item.statusText}}</view>
      </view>

      <!-- 举报对象详情（商品） -->
      <view wx:if="{{item.targetType === 'PRODUCT' && item.target}}" class="target-card">
        <view class="target-image-wrap">
          <image wx:if="{{item.target.image}}" class="target-image" src="{{item.target.image}}" mode="aspectFill" />
          <view wx:else class="target-image-placeholder">
            <image class="target-image-icon" src="/assets/icons/package.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="target-info">
          <view class="target-title">{{item.target.title}}</view>
          <view class="target-meta">价格 {{item.target.priceText}}</view>
          <view class="target-meta">商品 #{{item.target.id}}{{item.target.statusText ? ' · ' + item.target.statusText : ''}}</view>
        </view>
      </view>

      <!-- 举报对象详情（用户） -->
      <view wx:elif="{{item.targetType === 'USER' && item.target}}" class="target-card">
        <view class="target-image-wrap">
          <image wx:if="{{item.target.avatar}}" class="target-image" src="{{item.target.avatar}}" mode="aspectFill" />
          <view wx:else class="target-image-placeholder">
            <image class="target-image-icon" src="/assets/icons/user.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="target-info">
          <view class="target-title">{{item.target.nickname}}</view>
          <view class="target-meta">用户 #{{item.target.id}}{{item.target.statusText ? ' · ' + item.target.statusText : ''}}</view>
          <view class="target-meta">信用分 {{item.target.score}}</view>
        </view>
      </view>

      <!-- 举报对象详情（订单） -->
      <view wx:elif="{{item.targetType === 'ORDER' && item.target}}" class="target-card">
        <view class="target-image-wrap">
          <image wx:if="{{item.target.product && item.target.product.image}}" class="target-image" src="{{item.target.product.image}}" mode="aspectFill" />
          <view wx:else class="target-image-placeholder">
            <image class="target-image-icon" src="/assets/icons/package.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="target-info">
          <view class="target-title">{{item.target.product.title || '订单商品不可用'}}</view>
          <view class="target-meta">订单 #{{item.target.id}} · 金额 {{item.target.amountText}}</view>
          <view class="target-meta">{{item.target.statusText}}</view>
        </view>
      </view>

      <!-- 举报对象已不存在时的兜底 -->
      <view wx:elif="{{!item.target}}" class="report-reporter">举报对象 #{{item.targetId}}（信息不可用）</view>

      <!-- 举报原因 -->
      <view class="report-reason">{{item.reason}}</view>

      <!-- 处理信息（已处理/已驳回时展示） -->
      <view wx:if="{{!item.isOpen && item.handleAction}}" class="handle-info">
        <view class="handle-divider"></view>
        <view class="handle-row">
          <text class="handle-label">处理结果：</text>
          <text class="handle-value">{{item.handleAction}}</text>
        </view>
        <view wx:if="{{item.handleReason}}" class="handle-row">
          <text class="handle-label">处理说明：</text>
          <text class="handle-value">{{item.handleReason}}</text>
        </view>
      </view>
    </view>
  </view>

  <empty-state wx:elif="{{!loading && !errorMsg}}" message="暂无举报记录" />

  <view class="bottom-tip" wx:if="{{reports.length > 0}}">
    <text wx:if="{{loading}}">正在加载更多...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>
</view>
