page {
  background: var(--color-bg);
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  opacity: 0.04;
}

.page-body {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

.page-content {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.section {
  margin: 20rpx 24rpx 0;
  padding: 26rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 6rpx;
  height: 22rpx;
  background: var(--color-brand-gold);
  border-radius: 999rpx;
}

.section-hint,
.input-counter {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.input-field,
.textarea-field,
.picker-row,
.price-input-wrap {
  width: 100%;
  color: var(--color-text);
  font-size: 28rpx;
  background: #f2f2f7;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.input-field {
  height: 82rpx;
  padding: 0 20rpx;
}

.textarea-field {
  min-height: 184rpx;
  padding: 20rpx;
  line-height: 1.6;
}

.input-error,
.picker-error {
  border: 2rpx solid var(--color-danger);
  background: #fff2f1;
}

.error-text {
  display: block;
  margin-top: 10rpx;
  color: var(--color-danger);
  font-size: 24rpx;
}

.price-input-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding-right: 18rpx;
}

.price-symbol {
  padding-left: 20rpx;
  color: var(--color-danger);
  font-size: 34rpx;
  font-weight: 800;
}

.price-input {
  flex: 1;
  min-width: 0;
  background: transparent;
}

.picker-row {
  height: 82rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-placeholder {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.picker-value {
  color: var(--color-text);
  font-size: 28rpx;
}

.picker-arrow {
  color: var(--color-text-tertiary);
  font-size: 36rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.image-item,
.image-add {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 22rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
  background: rgba(29, 29, 31, 0.58);
  border-radius: 50%;
  backdrop-filter: blur(14rpx);
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-primary);
  background: #f2f2f7;
  border: 2rpx dashed var(--color-border-strong);
}

.add-icon {
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.add-text {
  font-size: 23rpx;
  font-weight: 500;
}

.bottom-spacer {
  height: 380rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom) + 128rpx);
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid var(--color-border);
  backdrop-filter: blur(24rpx);
  box-sizing: border-box;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  background: var(--color-primary);
  border-radius: 22rpx;
}

.btn-submitting {
  opacity: 0.72;
}

.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  background: rgba(0, 0, 0, 0.34);
}

.picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1101;
  max-height: 62vh;
  overflow-y: auto;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-surface);
  border-radius: 28rpx 28rpx 0 0;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-cancel {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.picker-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.picker-confirm {
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.picker-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 32rpx;
  color: var(--color-text);
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}
