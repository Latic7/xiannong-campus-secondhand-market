/* ── 页面容器 ──────────────────────────────── */
page { background: transparent; }

/* 页面背景图 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.page-body {
  position: relative;
  padding-bottom: 140rpx;
  background: transparent;
}

/* ── 区块 ──────────────────────────────────── */
.section { margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; padding: 28rpx; }
.section-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.section-hint { font-size: 24rpx; color: #999; }
.input-counter { font-size: 24rpx; color: #999; }

/* ── 输入框 ────────────────────────────────── */
.input-field {
  width: 100%; height: 80rpx; padding: 0 20rpx;
  font-size: 28rpx; color: #1a1a1a;
  background: #f8f8f8; border-radius: 12rpx;
  box-sizing: border-box;
}
.textarea-field {
  width: 100%; min-height: 180rpx; padding: 20rpx;
  font-size: 28rpx; color: #1a1a1a;
  background: #f8f8f8; border-radius: 12rpx;
  box-sizing: border-box; line-height: 1.6;
}
.input-error { border: 2rpx solid #e53e3e !important; background: #fff5f5 !important; }
.error-text { display: block; margin-top: 10rpx; font-size: 24rpx; color: #e53e3e; }

/* ── 价格输入 ──────────────────────────────── */
.price-input-wrap {
  display: flex; align-items: center; gap: 8rpx;
  background: #f8f8f8; border-radius: 12rpx; padding-right: 20rpx;
}
.price-symbol {
  padding: 0 16rpx; font-size: 36rpx; font-weight: 600;
  color: #e53e3e;
}
.price-input { background: transparent; flex: 1; }

/* ── 选择器行 ──────────────────────────────── */
.picker-row {
  display: flex; align-items: center; justify-content: space-between;
  height: 80rpx; padding: 0 20rpx;
  background: #f8f8f8; border-radius: 12rpx;
}
.picker-placeholder { font-size: 28rpx; color: #999; }
.picker-value { font-size: 28rpx; color: #1a1a1a; }
.picker-arrow { font-size: 36rpx; color: #ccc; }
.picker-error { border: 2rpx solid #e53e3e !important; background: #fff5f5 !important; }

/* ── 图片网格 ──────────────────────────────── */
.image-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.image-item {
  position: relative; width: 200rpx; height: 200rpx;
  border-radius: 12rpx; overflow: hidden;
}
.image-thumb { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx;
  text-align: center; font-size: 24rpx; color: #fff;
  background: rgba(0,0,0,0.6); border-radius: 50%;
}
.image-add {
  width: 200rpx; height: 200rpx;
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 8rpx;
  border: 2rpx dashed #ccc; border-radius: 12rpx;
  background: #fafafa;
}
.add-icon { font-size: 56rpx; color: #ccc; line-height: 1; }
.add-text { font-size: 22rpx; color: #999; }

/* ── 底部提交栏 ────────────────────────────── */
.bottom-spacer { height: 40rpx; }
.submit-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.btn-submit {
  width: 100%; height: 88rpx; line-height: 88rpx;
  font-size: 32rpx; font-weight: 600; color: #fff;
  background: linear-gradient(135deg, #4F46E5, #7c3aed);
  border-radius: 44rpx; text-align: center;
}
.btn-submitting { opacity: 0.7; }

/* ── 自定义底部弹窗（action-sheet） ────────── */
.picker-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 200;
}
.picker-panel {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  z-index: 201; max-height: 60vh; overflow-y: auto;
  padding-bottom: env(safe-area-inset-bottom);
}
.picker-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx; border-bottom: 1rpx solid #f0f0f0;
}
.picker-cancel { font-size: 28rpx; color: #999; }
.picker-title { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.picker-confirm { font-size: 28rpx; color: #4F46E5; font-weight: 600; }
.picker-option {
  display: flex; align-items: center; padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5; gap: 20rpx;
  font-size: 28rpx; color: #1a1a1a;
}
