<view class="container">
  <!-- 背景图 -->
  <image class="page-bg" src="/assets/images/Background.png" mode="aspectFill" />

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索商品"
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
    <view class="filter-toggle-btn {{showFilter ? 'active' : ''}}" bindtap="onFilterToggle">
      <view class="funnel-icon">
        <view class="funnel-top"></view>
        <view class="funnel-body"></view>
      </view>
    </view>
  </view>

  <!-- 已选筛选标签 -->
  <view class="active-tags" wx:if="{{activeTags.length > 0}}">
    <scroll-view class="tags-scroll" scroll-x>
      <view class="tags-list">
        <view
          class="filter-tag"
          wx:for="{{activeTags}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onRemoveTag"
        >
          <text class="tag-prefix">{{item.prefix}}：</text>
          <text class="tag-label">{{item.label}}</text>
          <text class="tag-remove">✕</text>
        </view>
      </view>
    </scroll-view>
    <view class="clear-all-btn" bindtap="onClearAllFilters">
      <text>清除全部</text>
    </view>
  </view>

  <!-- 分类栏 -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-list">
      <view
        class="category-item {{item.id === categoryId ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryChange"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 排序栏 -->
  <view class="sort-bar">
    <view
      class="sort-pill {{sort === 'createdAt_desc' ? 'active' : ''}}"
      data-sort="createdAt_desc"
      bindtap="onSortTap"
    >
      <text>最新</text>
    </view>
    <view
      class="sort-pill {{sort === 'price_asc' ? 'active' : ''}}"
      data-sort="price_asc"
      bindtap="onSortTap"
    >
      <text>价格↑</text>
    </view>
    <view
      class="sort-pill {{sort === 'price_desc' ? 'active' : ''}}"
      data-sort="price_desc"
      bindtap="onSortTap"
    >
      <text>价格↓</text>
    </view>
    <view
      class="sort-pill {{sort === 'hot' ? 'active' : ''}}"
      data-sort="hot"
      bindtap="onSortTap"
    >
      <text>热门</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel" wx:if="{{showFilter}}">
    <view class="filter-section">
      <view class="filter-label">价格区间</view>
      <view class="price-tags">
        <view
          class="price-tag {{selectedPriceIndex === index ? 'active' : ''}}"
          wx:for="{{priceRanges}}"
          wx:key="index"
          data-min="{{item.min}}"
          data-max="{{item.max}}"
          data-index="{{index}}"
          bindtap="onPriceRangeChange"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="custom-price-row">
        <input
          class="custom-price-input"
          type="digit"
          placeholder="最低价"
          value="{{customPriceMin}}"
          bindinput="onCustomPriceMinInput"
        />
        <text class="custom-price-divider">—</text>
        <input
          class="custom-price-input"
          type="digit"
          placeholder="最高价"
          value="{{customPriceMax}}"
          bindinput="onCustomPriceMaxInput"
        />
        <view class="custom-price-confirm" bindtap="onCustomPriceConfirm">
          <text>确定</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 初始加载骨架屏 -->
  <loading-state wx:if="{{loading && products.length === 0}}" count="4" />

  <!-- 商品列表 -->
  <view class="product-list" wx:if="{{products.length > 0}}">
    <block wx:for="{{products}}" wx:key="id">
      <item-card item="{{item}}" bind:tap="onCardTap" />
    </block>
  </view>

  <!-- 空状态 -->
  <empty-state wx:if="{{!loading && products.length === 0}}" message="暂无商品" />

  <!-- 底部加载提示 -->
  <view class="bottom-tip" wx:if="{{products.length > 0}}">
    <text wx:if="{{loading}}">正在加载更多...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>
</view>