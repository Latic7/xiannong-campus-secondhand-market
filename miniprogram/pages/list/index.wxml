<image class="page-bg" src="/assets/images/Background.jpg" mode="aspectFill" />
<view class="container">
  <!-- 页面标题（我的发布 / 我的收藏） -->
  <view class="page-title-bar" wx:if="{{listType}}">
    <text class="page-title-text">{{pageTitle}}</text>
  </view>

  <!-- 搜索栏（仅全部商品模式显示） -->
  <view class="search-bar" wx:if="{{!listType}}">
    <input
      class="search-input"
      placeholder="搜索教材、宿舍好物、数码配件"
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
  </view>

  <!-- 已选筛选标签 -->
  <view class="active-tags" wx:if="{{activeTags.length > 0}}">
    <scroll-view class="tags-scroll" scroll-x>
      <view class="tags-list">
        <view
          class="filter-tag"
          wx:for="{{activeTags}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onRemoveTag"
        >
          <text class="tag-prefix">{{item.prefix}}：</text>
          <text class="tag-label">{{item.label}}</text>
          <text class="tag-remove">✕</text>
        </view>
      </view>
    </scroll-view>
    <view class="clear-all-btn" bindtap="onClearAllFilters">
      <text>清除全部</text>
    </view>
  </view>

  <!-- 分类栏 -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-list">
      <view
        class="category-item {{item.id === categoryId ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryChange"
      >
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 初始加载骨架屏 -->
  <loading-state wx:if="{{loading && products.length === 0}}" count="4" />

  <!-- 错误态 -->
  <error-tip wx:elif="{{!loading && errorMsg && products.length === 0}}" message="{{errorMsg}}" bind:retry="onRetry" />

  <!-- 商品列表 -->
  <view class="product-list" wx:elif="{{products.length > 0}}">
    <block wx:for="{{products}}" wx:key="id">
      <item-card item="{{item}}" bind:tap="onCardTap" />
    </block>
  </view>

  <!-- 空状态 -->
  <empty-state wx:elif="{{!loading && !errorMsg && products.length === 0}}" message="暂无商品" />

  <!-- 底部加载提示 -->
  <view class="bottom-tip" wx:if="{{products.length > 0}}">
    <text wx:if="{{loading}}">正在加载更多...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>

  <view
    class="floating-backdrop {{showSortPanel || showFilter ? 'active' : ''}}"
    catchtap="onCloseFloatingPanels"
  ></view>

  <!-- 筛选悬浮窗 -->
  <view class="filter-panel {{showFilter ? 'active' : ''}}" catchtap="noop">
    <view class="filter-section">
      <view class="filter-label">价格区间</view>
      <view class="price-tags">
        <view
          class="price-tag {{selectedPriceIndex === index ? 'active' : ''}}"
          wx:for="{{priceRanges}}"
          wx:key="index"
          data-min="{{item.min}}"
          data-max="{{item.max}}"
          data-index="{{index}}"
          bindtap="onPriceRangeChange"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="custom-price-row">
        <input
          class="custom-price-input"
          type="digit"
          placeholder="最低价"
          value="{{customPriceMin}}"
          bindinput="onCustomPriceMinInput"
        />
        <text class="custom-price-divider">—</text>
        <input
          class="custom-price-input"
          type="digit"
          placeholder="最高价"
          value="{{customPriceMax}}"
          bindinput="onCustomPriceMaxInput"
        />
        <view class="custom-price-confirm" bindtap="onCustomPriceConfirm">
          <text>确定</text>
        </view>
      </view>
    </view>
  </view>

  <view class="floating-action-bar" catchtap="noop">
    <view class="sort-float-stack {{showSortPanel ? 'active' : ''}} {{hasSortSelection ? 'selected' : ''}}">
      <view class="sort-expanding-panel">
        <view
          class="sort-option {{sort === item.value ? 'active' : ''}}"
          wx:for="{{sortOptions}}"
          wx:key="value"
          data-sort="{{item.value}}"
          data-label="{{item.label}}"
          bindtap="onSortTap"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="floating-action sort-trigger {{showSortPanel ? 'active' : ''}}" bindtap="onSortToggle">
        <view class="sort-action-icon">
          <view class="sort-action-line long"></view>
          <view class="sort-action-line medium"></view>
          <view class="sort-action-line short"></view>
        </view>
        <text>{{currentSortLabel}}</text>
      </view>
    </view>
    <view class="floating-action {{showFilter || hasFilters ? 'active' : ''}}" bindtap="onFilterToggle">
      <view class="filter-action-icon">
        <view class="filter-action-row top"></view>
        <view class="filter-action-row bottom"></view>
      </view>
      <text>筛选</text>
    </view>
  </view>
</view>
