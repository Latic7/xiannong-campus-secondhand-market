/* 页面背景图 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.container {
  position: relative;
  padding: 32rpx;
  min-height: 100vh;
  background: transparent;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  padding: 24rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-input::placeholder {
  color: #9CA3AF;
}

.filter-btn {
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
  padding: 24rpx 32rpx;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.3);
}

.filter-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #4B5563;
  display: inline-block;
  transition: all 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  white-space: nowrap;
}

.category-item.active {
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(79, 70, 229, 0.3);
}

.filter-actions {
  display: flex;
  gap: 12rpx;
}

.sort-btn {
  background: #fff;
  padding: 14rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #4B5563;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.sort-btn.active {
  border: 2rpx solid #4F46E5;
  color: #4F46E5;
  background: #EEF2FF;
}

.filter-icon {
  background: #fff;
  padding: 14rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-icon text {
  font-size: 32rpx;
}

/* 筛选面板 */
.filter-panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 20rpx;
}

.price-range-scroll {
  white-space: nowrap;
}

.price-range-list {
  display: flex;
  gap: 16rpx;
}

.price-range-item {
  padding: 16rpx 28rpx;
  background: #F3F4F6;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #4B5563;
  display: inline-block;
  transition: all 0.2s;
  border: 2rpx solid transparent;
  white-space: nowrap;
}

.price-range-item.active {
  background: #EEF2FF;
  border-color: #4F46E5;
  color: #4F46E5;
  font-weight: 500;
}

.filter-summary {
  padding-top: 24rpx;
  border-top: 2rpx solid #F3F4F6;
}

.filter-summary text {
  font-size: 26rpx;
  color: #6B7280;
}

/* 商品列表 */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.bottom-tip {
  text-align: center;
  padding: 32rpx 0;
}

.bottom-tip text {
  font-size: 26rpx;
  color: #9CA3AF;
}
