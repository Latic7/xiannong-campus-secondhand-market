.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  opacity: 0.04;
}

.container {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 26rpx;
  color: var(--color-text);
  font-size: 28rpx;
  background: #e9e9ee;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.search-input::placeholder {
  color: var(--color-text-tertiary);
}

.filter-toggle-btn {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  transition: transform 0.18s ease, background 0.18s ease;
}

.filter-toggle-btn:active {
  transform: scale(0.96);
}

.filter-toggle-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.funnel-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 26rpx;
}

.funnel-top {
  width: 26rpx;
  height: 6rpx;
  background: var(--color-text-secondary);
  border-radius: 6rpx 6rpx 0 0;
}

.funnel-body {
  width: 0;
  height: 0;
  border-left: 15rpx solid transparent;
  border-right: 15rpx solid transparent;
  border-top: 16rpx solid var(--color-text-secondary);
}

.filter-toggle-btn.active .funnel-top {
  background: #ffffff;
}

.filter-toggle-btn.active .funnel-body {
  border-top-color: #ffffff;
}

.active-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tags-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.tags-list {
  display: flex;
  gap: 12rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  background: var(--color-primary-soft);
  border-radius: 999rpx;
}

.tag-prefix,
.tag-label,
.tag-remove {
  font-size: 23rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.tag-label {
  max-width: 168rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.clear-all-btn {
  flex-shrink: 0;
  padding: 8rpx 0;
}

.clear-all-btn text {
  font-size: 24rpx;
  color: var(--color-danger);
  font-weight: 500;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.category-list {
  display: inline-flex;
  gap: 12rpx;
}

.category-item,
.sort-pill,
.price-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
}

.category-item {
  min-height: 64rpx;
  padding: 0 24rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}

.category-item:active,
.sort-pill:active,
.price-tag:active {
  transform: scale(0.97);
}

.category-item.active,
.sort-pill.active,
.price-tag.active {
  color: #ffffff;
  font-weight: 600;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.sort-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 22rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.sort-pill {
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 0 22rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  background: transparent;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}

.filter-panel {
  margin-bottom: 22rpx;
  padding: 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
}

.filter-label::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 22rpx;
  margin-right: 10rpx;
  vertical-align: -3rpx;
  background: var(--color-brand-gold);
  border-radius: 999rpx;
}

.filter-section {
  margin-bottom: 0;
}

.filter-label {
  margin-bottom: 16rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.price-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.price-tag {
  min-height: 58rpx;
  padding: 0 22rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  background: #f2f2f7;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
}

.custom-price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.custom-price-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 16rpx;
  color: var(--color-text);
  font-size: 25rpx;
  text-align: center;
  background: #f2f2f7;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.custom-price-divider {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.custom-price-confirm {
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  border-radius: 18rpx;
}

.custom-price-confirm text {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bottom-tip {
  padding: 34rpx 0 48rpx;
  text-align: center;
}

.bottom-tip text {
  color: var(--color-text-tertiary);
  font-size: 25rpx;
}
