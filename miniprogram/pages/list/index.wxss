.container {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 28rpx 220rpx;
  background: rgba(245, 245, 247, 0.2);
}



.page-title-bar {
  margin-bottom: 20rpx;
  padding: 20rpx 8rpx;
}

.page-title-text {
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 800;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 26rpx;
  color: var(--color-text);
  font-size: 28rpx;
  background: #e9e9ee;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.search-input::placeholder {
  color: var(--color-text-tertiary);
}

.filter-toggle-btn {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  transition: transform 0.18s ease, background 0.18s ease;
}

.filter-toggle-btn:active {
  transform: scale(0.96);
}

.filter-toggle-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.funnel-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 26rpx;
}

.funnel-top {
  width: 26rpx;
  height: 6rpx;
  background: var(--color-text-secondary);
  border-radius: 6rpx 6rpx 0 0;
}

.funnel-body {
  width: 0;
  height: 0;
  border-left: 15rpx solid transparent;
  border-right: 15rpx solid transparent;
  border-top: 16rpx solid var(--color-text-secondary);
}

.filter-toggle-btn.active .funnel-top {
  background: #ffffff;
}

.filter-toggle-btn.active .funnel-body {
  border-top-color: #ffffff;
}

.active-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tags-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.tags-list {
  display: flex;
  gap: 12rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  background: var(--color-primary-soft);
  border-radius: 999rpx;
}

.tag-prefix,
.tag-label,
.tag-remove {
  font-size: 23rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.tag-label {
  max-width: 168rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.clear-all-btn {
  flex-shrink: 0;
  padding: 8rpx 0;
}

.clear-all-btn text {
  font-size: 24rpx;
  color: var(--color-danger);
  font-weight: 500;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.category-list {
  display: inline-flex;
  gap: 12rpx;
}

.category-item,
.price-tag,
.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
}

.category-item {
  min-height: 64rpx;
  padding: 0 24rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
}

.category-item:active,
.price-tag:active,
.status-tag:active {
  transform: scale(0.97);
}

.category-item.active,
.price-tag.active,
.status-tag.active {
  color: #ffffff;
  font-weight: 600;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.filter-panel {
  position: fixed;
  right: 32rpx;
  bottom: calc(144rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  z-index: 45;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.46);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
  border-radius: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(16rpx);
  opacity: 0;
  pointer-events: none;
  transform: translateY(34rpx) scale(0.96);
  transform-origin: center bottom;
  transition: none;
}

.filter-panel.active {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0) scale(1);
  transition: opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.filter-label::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 22rpx;
  margin-right: 10rpx;
  vertical-align: -3rpx;
  background: var(--color-brand-gold);
  border-radius: 999rpx;
}

.filter-section {
  margin-bottom: 0;
}

.filter-label {
  margin-bottom: 16rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.price-tags,
.status-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.price-tag,
.status-tag {
  min-height: 58rpx;
  padding: 0 22rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  background: #f2f2f7;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
}

.custom-price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.custom-price-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 16rpx;
  color: var(--color-text);
  font-size: 25rpx;
  text-align: center;
  background: #f2f2f7;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.custom-price-divider {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.custom-price-confirm {
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  border-radius: 18rpx;
}

.custom-price-confirm text {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bottom-tip {
  padding: 34rpx 0 48rpx;
  text-align: center;
}

.bottom-tip text {
  color: var(--color-text-tertiary);
  font-size: 25rpx;
}

.floating-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 35;
  background: rgba(0, 0, 0, 0.02);
  opacity: 0;
  pointer-events: none;
  transition: none;
}

.floating-backdrop.active {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.22s ease;
}

.sort-option {
  height: 94rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #080808;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  opacity: 0;
  transform: translateY(34rpx) scale(0.96);
  transition: none;
}

.sort-option:last-child {
  margin-bottom: 26rpx;
}

.sort-option:active {
  transform: scale(0.97);
}

.sort-option.active {
  color: #050505;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: inset 0 0 0 2rpx rgba(20, 15, 13, 0.16);
}

.sort-option text {
  font-size: 29rpx;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Helvetica Neue", Arial, sans-serif;
  font-weight: 500;
}

.sort-float-stack.active .sort-option {
  opacity: 1;
  transform: translateY(0) scale(1);
  transition: opacity 0.58s ease,
    transform 0.68s cubic-bezier(0.16, 1, 0.3, 1),
    background 0.18s ease,
    color 0.18s ease;
}

.sort-float-stack.active .sort-option:nth-child(4) {
  transition-delay: 0.12s, 0.12s, 0s, 0s;
}

.sort-float-stack.active .sort-option:nth-child(3) {
  transition-delay: 0.22s, 0.22s, 0s, 0s;
}

.sort-float-stack.active .sort-option:nth-child(2) {
  transition-delay: 0.32s, 0.32s, 0s, 0s;
}

.sort-float-stack.active .sort-option:nth-child(1) {
  transition-delay: 0.42s, 0.42s, 0s, 0s;
}

.floating-action-bar {
  position: fixed;
  left: 50%;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  transform: translateX(-50%);
}

.sort-float-stack {
  width: 212rpx;
  padding: 0;
  flex-shrink: 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0);
  border: 1rpx solid rgba(255, 255, 255, 0);
  border-radius: 46rpx;
  box-shadow: none;
  backdrop-filter: none;
  box-sizing: border-box;
  transform-origin: center bottom;
  transition: none;
}

.sort-float-stack.active {
  width: 340rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.46);
  border-color: rgba(255, 255, 255, 0.38);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.14);
  backdrop-filter: blur(16rpx);
  transition: width 0.52s cubic-bezier(0.16, 1, 0.3, 1),
    padding 0.52s cubic-bezier(0.16, 1, 0.3, 1),
    background 0.38s ease,
    border-color 0.38s ease,
    box-shadow 0.38s ease;
}

.sort-float-stack.selected {
  width: 340rpx;
}

.sort-expanding-panel {
  max-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  transform: translateY(28rpx) scale(0.96);
  transform-origin: center bottom;
  transition: none;
}

.sort-float-stack.active .sort-expanding-panel {
  max-height: 444rpx;
  transform: translateY(0) scale(1);
  transition: max-height 0.72s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);
}

.floating-action {
  min-width: 212rpx;
  height: 92rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #ffffff;
  background: #140f0d;
  border-radius: 999rpx;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
  transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s ease;
}

.sort-trigger {
  width: 100%;
  min-width: 0;
}

.sort-float-stack.selected .sort-trigger text {
  max-width: 260rpx;
}

.floating-action:active {
  transform: scale(0.96);
}

.floating-action.active {
  opacity: 0.96;
  transform: translateY(-4rpx);
}

.sort-trigger.active {
  opacity: 1;
  transform: none;
}

.floating-action text {
  max-width: 176rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 29rpx;
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Helvetica Neue", Arial, sans-serif;
  font-weight: 500;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sort-action-icon,
.filter-action-icon {
  position: relative;
  width: 38rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.sort-action-line {
  position: absolute;
  left: 0;
  height: 4rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.sort-action-line.long {
  top: 4rpx;
  width: 36rpx;
}

.sort-action-line.medium {
  top: 15rpx;
  width: 28rpx;
}

.sort-action-line.short {
  top: 26rpx;
  width: 20rpx;
}

.filter-action-row {
  position: absolute;
  left: 0;
  width: 38rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.filter-action-row.top {
  top: 8rpx;
}

.filter-action-row.bottom {
  bottom: 8rpx;
}

.filter-action-row::after {
  content: '';
  position: absolute;
  top: -6rpx;
  width: 16rpx;
  height: 16rpx;
  background: #140f0d;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.filter-action-row.top::after {
  left: 6rpx;
}

.filter-action-row.bottom::after {
  right: 6rpx;
}
