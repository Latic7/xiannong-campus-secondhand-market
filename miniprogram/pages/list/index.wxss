/* ===== 页面背景 ===== */
.page-bg {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -1;
}

.container {
  position: relative;
  padding: 24rpx;
  min-height: 100vh;
  background: transparent;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  padding: 22rpx 28rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-input::placeholder {
  color: #9CA3AF;
}

.filter-toggle-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
  transition: all 0.2s;
}

.filter-toggle-btn.active {
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.35);
}

/* 漏斗图标 */
.funnel-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 24rpx;
}

.funnel-top {
  width: 24rpx;
  height: 6rpx;
  background: #4B5563;
  border-radius: 3rpx 3rpx 0 0;
  transition: background 0.2s;
}

.funnel-body {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 16rpx solid #4B5563;
  transition: border-top-color 0.2s;
}

.filter-toggle-btn.active .funnel-top {
  background: #fff;
}

.filter-toggle-btn.active .funnel-body {
  border-top-color: #fff;
}

/* ===== 已选筛选标签 ===== */
.active-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tags-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.tags-list {
  display: flex;
  gap: 16rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #EEF2FF;
  border: 2rpx solid #C7D2FE;
  border-radius: 28rpx;
  padding: 10rpx 18rpx;
  flex-shrink: 0;
}

.tag-prefix {
  font-size: 22rpx;
  color: #6366F1;
  font-weight: 500;
}

.tag-label {
  font-size: 24rpx;
  color: #4338CA;
  font-weight: 500;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-remove {
  font-size: 22rpx;
  color: #6366F1;
  margin-left: 4rpx;
}

.clear-all-btn {
  flex-shrink: 0;
  background: none;
  border: none;
  padding: 10rpx 0;
}

.clear-all-btn text {
  font-size: 24rpx;
  color: #EF4444;
  font-weight: 500;
}

/* ===== 分类栏 ===== */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #4B5563;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
  border: 2rpx solid transparent;
  white-space: nowrap;
}

.category-item.active {
  background: #EEF2FF;
  border-color: #6366F1;
  color: #4338CA;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(99, 102, 241, 0.2);
}

/* ===== 排序栏 ===== */
.sort-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.sort-pill {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: #fff;
  border: 2rpx solid #E5E7EB;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #6B7280;
  transition: all 0.2s;
  white-space: nowrap;
}

.sort-pill.active {
  background: #EEF2FF;
  border-color: #6366F1;
  color: #4338CA;
  font-weight: 600;
}

/* ===== 筛选面板 ===== */
.filter-panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

/* 价格区间 - 换行布局 */
.price-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.price-tag {
  padding: 14rpx 24rpx;
  background: #F3F4F6;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #4B5563;
  transition: all 0.2s;
  white-space: nowrap;
}

.price-tag.active {
  background: #EEF2FF;
  border-color: #6366F1;
  color: #4338CA;
  font-weight: 600;
}

/* 自定义价格 */
.custom-price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F3F4F6;
}

.custom-price-input {
  flex: 1;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #1F2937;
  text-align: center;
}

.custom-price-divider {
  font-size: 28rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.custom-price-confirm {
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  border-radius: 16rpx;
  padding: 14rpx 28rpx;
  flex-shrink: 0;
}

.custom-price-confirm text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 商品列表 ===== */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 底部提示 ===== */
.bottom-tip {
  text-align: center;
  padding: 32rpx 0 48rpx;
}

.bottom-tip text {
  font-size: 26rpx;
  color: #9CA3AF;
}
