page {
  background: var(--color-bg);
}



.page-body {
  position: relative;
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: rgba(245, 245, 247, 0.2);
}

.page-status {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: var(--color-bg);
}

.loading-spinner {
  width: 58rpx;
  height: 58rpx;
  border: 5rpx solid rgba(60, 60, 67, 0.14);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.85s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.status-icon-img {
  width: 82rpx;
  height: 82rpx;
  opacity: 0.38;
}

.status-text {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.btn-retry {
  margin-top: 16rpx;
  padding: 14rpx 34rpx;
  color: var(--color-primary);
  font-size: 28rpx;
  background: var(--color-primary-soft);
  border-radius: 999rpx;
}

.image-section {
  position: relative;
  width: 100%;
  height: 720rpx;
  background: #111111;
}

.image-swiper,
.swiper-image {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(29, 29, 31, 0.48);
  border-radius: 999rpx;
  backdrop-filter: blur(18rpx);
}

.info-section,
.desc-section,
.seller-section {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  box-sizing: border-box;
}

.info-section {
  border-top: 6rpx solid rgba(11, 107, 67, 0.18);
}

.price-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.price-current {
  color: var(--color-danger);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.12;
}

.price-original {
  color: var(--color-text-tertiary);
  font-size: 26rpx;
  text-decoration: line-through;
}

.status-tag {
  margin-left: auto;
  padding: 6rpx 14rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.title-row {
  margin-bottom: 18rpx;
}

.product-title {
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
}

.meta-icon-img {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.52;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.stat-icon-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  opacity: 0.48;
}

.divider {
  display: none;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  margin-bottom: 18rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 6rpx;
  height: 22rpx;
  background: var(--color-brand-gold);
  border-radius: 999rpx;
}

.desc-content {
  color: #3a3a3c;
  font-size: 28rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.seller-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.seller-avatar {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #ededf2;
}

.seller-info {
  flex: 1;
  min-width: 0;
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.seller-nickname {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reputation-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  background: var(--color-brand-gold-soft);
  border-radius: 999rpx;
}

.reputation-star-img {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.reputation-score {
  color: var(--color-warning);
  font-size: 22rpx;
  font-weight: 700;
}

.seller-stats {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.seller-stat-divider {
  margin: 0 8rpx;
  color: var(--color-border-strong);
}

.btn-contact {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
  background: var(--color-primary-soft);
  border-radius: 999rpx;
}

.bottom-placeholder {
  height: 132rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid var(--color-border);
  backdrop-filter: blur(24rpx);
  box-sizing: border-box;
}

.action-btn {
  width: 78rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
}

.action-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.action-label {
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.action-btn-primary,
.action-btn-disabled {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 22rpx;
}

.action-btn-primary {
  background: var(--color-primary);
}

.action-btn-disabled {
  color: var(--color-text-tertiary);
  background: #e5e5ea;
}

.action-btn-chat {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 22rpx;
  background: #e8f5e9;
  border: 2rpx solid var(--color-primary) !important;
}

.action-btn-chat::after {
  border: none;
}

.action-btn-unlist {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 22rpx;
  background: #ff3b30;
}
.action-btn-unlist::after {
  border: none;
}

.action-btn-unlist-disabled {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  color: var(--color-text-tertiary);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border-radius: 22rpx;
  background: #e5e5ea;
}
.action-btn-unlist-disabled::after {
  border: none;
}
