/* ── 页面容器 ──────────────────────────────── */
page { background: #f5f5f5; }
.page-body { padding-bottom: 120rpx; }

/* ── 加载 / 错误状态 ──────────────────────── */
.page-status {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; height: 100vh; gap: 20rpx;
}
.loading-spinner {
  width: 60rpx; height: 60rpx; border: 4rpx solid #e0e0e0;
  border-top-color: #4F46E5; border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.status-icon-img { width: 80rpx; height: 80rpx; opacity: 0.35; }
.status-text { font-size: 28rpx; color: #999; }
.btn-retry {
  margin-top: 20rpx; padding: 16rpx 48rpx; font-size: 28rpx;
  color: #4F46E5; background: #fff; border: 1rpx solid #4F46E5;
  border-radius: 40rpx;
}

/* ── 图片轮播 ──────────────────────────────── */
.image-section { position: relative; width: 100%; height: 750rpx; background: #000; }
.image-swiper { width: 100%; height: 100%; }
.swiper-image { width: 100%; height: 100%; }
.image-counter {
  position: absolute; right: 24rpx; bottom: 24rpx;
  padding: 8rpx 20rpx; font-size: 24rpx; color: #fff;
  background: rgba(0,0,0,0.5); border-radius: 24rpx;
}

/* ── 基本信息区 ────────────────────────────── */
.info-section { padding: 32rpx 28rpx; background: #fff; }

.price-row {
  display: flex; align-items: baseline; gap: 16rpx;
  margin-bottom: 16rpx; flex-wrap: wrap;
}
.price-current { font-size: 48rpx; font-weight: 700; color: #e53e3e; }
.price-original {
  font-size: 26rpx; color: #999; text-decoration: line-through;
}
.status-tag {
  margin-left: auto; padding: 4rpx 16rpx; font-size: 22rpx;
  color: #fff; border-radius: 8rpx;
}

.title-row { margin-bottom: 16rpx; }
.product-title {
  font-size: 34rpx; font-weight: 600; color: #1a1a1a;
  line-height: 1.5;
}

.meta-row {
  display: flex; flex-wrap: wrap; gap: 28rpx;
  margin-bottom: 16rpx;
}
.meta-item {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 26rpx; color: #666;
}
.meta-icon-img { width: 32rpx; height: 32rpx; flex-shrink: 0; opacity: 0.55; }

.stats-row {
  display: flex; flex-wrap: wrap; gap: 32rpx;
  padding-top: 16rpx; border-top: 1rpx solid #f0f0f0;
}
.stat-item {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 24rpx; color: #999;
}
.stat-icon-img { width: 28rpx; height: 28rpx; flex-shrink: 0; opacity: 0.5; }

/* ── 分隔线 ────────────────────────────────── */
.divider { height: 16rpx; background: #f5f5f5; }

/* ── 描述区 ────────────────────────────────── */
.desc-section { padding: 32rpx 28rpx; background: #fff; }
.section-title {
  font-size: 30rpx; font-weight: 600; color: #1a1a1a;
  margin-bottom: 20rpx; padding-left: 16rpx;
  border-left: 6rpx solid #4F46E5;
}
.desc-content { font-size: 28rpx; color: #444; line-height: 1.8; white-space: pre-wrap; }

/* ── 卖家信息 ──────────────────────────────── */
.seller-section { padding: 32rpx 28rpx; background: #fff; }
.seller-card {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx; background: #fafafa; border-radius: 16rpx;
}
.seller-avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  border: 2rpx solid #eee; flex-shrink: 0;
}
.seller-info { flex: 1; min-width: 0; }
.seller-name-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 8rpx;
}
.seller-nickname { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.reputation-badge {
  display: flex; align-items: center; gap: 4rpx;
  padding: 2rpx 12rpx; font-size: 22rpx;
  background: #fff7ed; border-radius: 20rpx;
}
.reputation-star-img { width: 22rpx; height: 22rpx; flex-shrink: 0; }
.reputation-score { color: #f59e0b; font-weight: 600; }
.seller-stats { font-size: 24rpx; color: #999; }
.seller-stat-divider { margin: 0 8rpx; }
.btn-contact {
  flex-shrink: 0; padding: 12rpx 28rpx; font-size: 26rpx;
  color: #4F46E5; background: #eef2ff; border-radius: 32rpx;
}

/* ── 底部操作栏 ────────────────────────────── */
.bottom-placeholder { height: 120rpx; }
.action-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 28rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.action-btn {
  display: flex; flex-direction: column; align-items: center;
  gap: 4rpx; padding: 8rpx 16rpx; flex-shrink: 0;
}
.action-icon-img { width: 40rpx; height: 40rpx; }
.action-label { font-size: 20rpx; color: #666; }
.action-btn-primary {
  flex: 1; height: 80rpx; line-height: 80rpx;
  font-size: 30rpx; font-weight: 600; color: #fff;
  background: linear-gradient(135deg, #4F46E5, #7c3aed);
  border-radius: 40rpx; text-align: center;
}
.action-btn-disabled {
  flex: 1; height: 80rpx; line-height: 80rpx;
  font-size: 30rpx; font-weight: 600; color: #999;
  background: #e5e5e5; border-radius: 40rpx; text-align: center;
}
