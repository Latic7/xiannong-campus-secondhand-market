page {
  background: var(--color-bg);
}

.page {
  position: relative;
  background: rgba(245, 245, 247, 0.2);
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.role-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.role-tab {
  min-width: 140rpx;
  height: 68rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.role-tab.active {
  color: #ffffff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  padding: 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}

.order-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.order-image-wrap {
  width: 132rpx;
  height: 132rpx;
  overflow: hidden;
  background: #ededf2;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.order-image,
.order-image-placeholder {
  width: 100%;
  height: 100%;
}

.order-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-image-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.34;
}

.order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.order-meta {
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.order-status {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.bottom-tip {
  padding: 28rpx 0 40rpx;
  text-align: center;
}

.bottom-tip text {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}
