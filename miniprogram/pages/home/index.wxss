.container {
  position: relative;
  min-height: 100vh;
  padding: 0 28rpx 160rpx;
  background: rgba(245, 245, 247, 0.2);
}



.nav-bar {
  margin: 0 -28rpx 28rpx;
  padding: 0 28rpx;
  background: rgba(245, 247, 245, 0.9);
  border-bottom: 1rpx solid var(--color-border);
  backdrop-filter: blur(24rpx);
}

.nav-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 92rpx;
}

.logo {
  width: 58rpx;
  height: 58rpx;
  padding: 7rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  box-sizing: border-box;
  box-shadow: 0 8rpx 18rpx rgba(11, 107, 67, 0.18);
}

.brand-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.app-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.15;
}

.app-subtitle {
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
}

.search-bar {
  height: 76rpx;
  padding: 0 26rpx;
  margin-bottom: 36rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #ebefec;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.48;
}

.search-placeholder {
  flex: 1;
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.section {
  margin-bottom: 44rpx;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  margin-bottom: 20rpx;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: var(--color-text);
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 6rpx;
  height: 26rpx;
  background: var(--color-brand-gold);
  border-radius: 999rpx;
}

.category-scroll,
.recommend-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.category-item {
  min-width: 124rpx;
  padding: 18rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid var(--color-border);
  border-radius: 22rpx;
  box-sizing: border-box;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.category-item:active {
  transform: scale(0.97);
  opacity: 0.78;
}

.category-icon-wrap {
  width: 70rpx;
  height: 70rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.category-name {
  max-width: 112rpx;
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-list {
  display: flex;
  gap: 18rpx;
  padding-bottom: 4rpx;
}

.recommend-item {
  position: relative;
  width: 296rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.recommend-item:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.recommend-image-wrap {
  position: relative;
  width: 296rpx;
  height: 296rpx;
}

.recommend-image {
  width: 100%;
  height: 100%;
  background: #ededf2;
  transition: filter 0.3s ease;
}

.recommend-image.img-grayscale {
  filter: grayscale(100%);
}

.recommend-status-tag {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  padding: 6rpx 14rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  backdrop-filter: blur(18rpx);
}

.recommend-status-tag.status-removed {
  background: rgba(99, 99, 102, 0.88);
}

.recommend-status-tag.status-sold {
  background: rgba(255, 59, 48, 0.88);
}

.recommend-tags {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
}

.recommend-condition {
  padding: 6rpx 14rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: rgba(11, 107, 67, 0.72);
  backdrop-filter: blur(18rpx);
}

.recommend-info {
  padding: 18rpx 18rpx 20rpx;
}

.recommend-title {
  min-height: 72rpx;
  margin-bottom: 12rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.32;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-price {
  color: var(--color-danger);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
  transition: color 0.3s ease;
}

.recommend-price.price-gray {
  color: #999;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.recommend-skeleton {
  width: 296rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}

.recommend-skeleton-img {
  width: 296rpx;
  height: 296rpx;
  background: linear-gradient(90deg, #eeeeef 25%, #f8f8fa 50%, #eeeeef 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.recommend-skeleton-info {
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.recommend-skeleton-title,
.recommend-skeleton-price {
  border-radius: 999rpx;
  background: linear-gradient(90deg, #eeeeef 25%, #f8f8fa 50%, #eeeeef 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.recommend-skeleton-title {
  width: 82%;
  height: 28rpx;
}

.recommend-skeleton-price {
  width: 108rpx;
  height: 32rpx;
  animation-delay: 0.15s;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}
