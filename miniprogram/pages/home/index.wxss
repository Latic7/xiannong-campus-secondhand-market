/* 页面背景图 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.container {
  position: relative;
  padding: 32rpx;
  padding-top: 0;
  min-height: 100vh;
  background: transparent;
}

/* 自定义导航栏 */
.nav-bar {
  margin-left: -32rpx;
  margin-right: -32rpx;
  margin-bottom: 32rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
}

.nav-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
}

.logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
}

.app-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

/* 搜索栏 - 渐变卡片风格 */
.search-bar {
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
  padding: 28rpx 36rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.3);
  margin-bottom: 40rpx;
}

.search-bar::before {
  content: '🔍';
  font-size: 32rpx;
  opacity: 0.8;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
  flex: 1;
}

/* 区块 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: linear-gradient(to right, #E5E7EB, transparent);
  margin-left: 16rpx;
}

/* 分类入口 */
.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s, box-shadow 0.2s;
  min-width: 120rpx;
}

.category-item:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.category-name {
  font-size: 24rpx;
  color: #1F2937;
  font-weight: 500;
}

/* 推荐商品横向滚动 */
.recommend-scroll {
  width: 100%;
  white-space: nowrap;
}

.recommend-list {
  display: flex;
  gap: 24rpx;
}

.recommend-item {
  width: 240rpx;
  flex-shrink: 0;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s, box-shadow 0.2s;
}

.recommend-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.recommend-image {
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
}

.recommend-info {
  padding: 20rpx;
}

.recommend-title {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 12rpx;
  min-height: 78rpx;
}

.recommend-price {
  font-size: 34rpx;
  color: #EF4444;
  font-weight: bold;
  display: flex;
  align-items: baseline;
}

.recommend-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

/* 最新商品列表 */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
