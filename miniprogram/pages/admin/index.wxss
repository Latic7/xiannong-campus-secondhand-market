/* Admin page styles */

page {
  background: var(--color-bg);
}

.page {
  position: relative;
  background: rgba(245, 245, 247, 0.2);
  min-height: 100vh;
  padding: 24rpx;
  padding-top: 0;
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  justify-content: flex-start;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(245, 245, 247, 0.95);
  padding: 0 24rpx;
  margin: 0 -24rpx 20rpx;
}

.tab-item {
  position: relative;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.tab-active {
  color: var(--color-primary);
  font-weight: 700;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  left: 20rpx;
  right: 20rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 14rpx;
}

.tab-badge-warning {
  background: #ff9500;
}



.admin-card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
}

.card-status {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.card-body {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.card-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-approve, .btn-reject, .btn-action {
  flex: 1;
  min-width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  padding: 0 16rpx;
}

.btn-approve {
  background: var(--color-primary);
  color: #fff;
}

.btn-reject {
  background: #f2f2f7;
  color: #ff3b30;
}

.btn-action {
  background: #f2f2f7;
  color: var(--color-text);
}
