/* Admin page styles */

page {
  background: var(--color-bg);
}

.page {
  position: relative;
  background: rgba(245, 245, 247, 0.2);
  min-height: 100vh;
  padding: 24rpx;
  padding-top: 0;
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  justify-content: flex-start;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(245, 245, 247, 0.95);
  padding: 0 24rpx;
  margin: 0 -24rpx 20rpx;
}

.tab-item {
  position: relative;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.tab-active {
  color: var(--color-primary);
  font-weight: 700;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  left: 20rpx;
  right: 20rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 14rpx;
}





.admin-card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 左侧缩略图 + 右侧信息 */
.card-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.card-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f2f2f7;
}

.card-thumb-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-thumb-placeholder::after {
  content: '暂无图片';
  font-size: 22rpx;
  color: #c7c7cc;
}

.card-info {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 4rpx;
}

.card-body {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.card-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 举报元信息 */
.rpt-meta {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--color-border);
  margin-bottom: 12rpx;
}

.rpt-meta-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.card-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.btn-approve, .btn-reject, .btn-action {
  flex: 1;
  min-width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  padding: 0 16rpx;
}

.btn-approve {
  background: var(--color-primary);
  color: #fff;
}

.btn-reject {
  background: #f2f2f7;
  color: #ff3b30;
}

.btn-action {
  background: #f2f2f7;
  color: var(--color-text);
}

/* ── 报表 ────────────────────────── */

.stats-section {
  padding: 24rpx;
}

.stats-date-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stats-date-input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  color: var(--color-text);
  font-size: 24rpx;
  background: #f2f2f7;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.stats-date-divider {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}

.stats-query-btn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--color-primary);
  border-radius: 14rpx;
}

.stats-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
}

.stats-card-title {
  margin-bottom: 16rpx;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 700;
}

.stats-overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stats-overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
}

.stats-overview-num {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 800;
}

.stats-overview-label {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.stats-series-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.stats-series-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.stats-series-label {
  color: var(--color-text);
  font-size: 24rpx;
}

.stats-series-value {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.stats-bar-track {
  height: 16rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
  overflow: hidden;
}

.stats-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 999rpx;
  transition: width 0.4s ease;
}
