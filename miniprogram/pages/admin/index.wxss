/* Admin page styles */

.page {
  min-height: 100vh;
  background: rgba(245, 245, 247, 0.2);
  position: relative;
}



.admin-menu {
  position: relative;
  z-index: 1;
  margin: 28rpx 24rpx;
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 24rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.menu-icon-img {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  opacity: 0.54;
}

.menu-text {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 500;
}

.menu-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 24rpx;
}

.menu-arrow {
  color: var(--color-text-secondary);
  font-size: 36rpx;
  opacity: 0.4;
}

.badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 18rpx;
  margin-right: 8rpx;
}

.badge-warning {
  background: #ff9500;
}
