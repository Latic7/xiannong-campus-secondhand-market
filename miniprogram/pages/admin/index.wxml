<image class="page-bg" src="/assets/images/Background.jpg" mode="aspectFill" />
<view class="page">
  <!-- tab 切换 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{tabIndex === index ? 'tab-active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      <text>{{item.label}}</text>
      <view wx:if="{{item.key === 'products' && pendingProducts > 0}}" class="tab-badge">{{pendingProducts > 99 ? '99+' : pendingProducts}}</view>
      <view wx:if="{{item.key === 'reports' && pendingReports > 0}}" class="tab-badge">{{pendingReports > 99 ? '99+' : pendingReports}}</view>
      <view wx:if="{{tabIndex === index}}" class="tab-underline"></view>
    </view>
  </view>

  <!-- 商品审核筛选 -->
  <view wx:if="{{tabIndex === 0}}" class="filter-bar">
    <view class="filter-btn {{prodFilter === 'pending' ? 'filter-active' : ''}}" data-filter="pending" bindtap="onProdFilterChange">待处理</view>
    <view class="filter-btn {{prodFilter === 'handled' ? 'filter-active' : ''}}" data-filter="handled" bindtap="onProdFilterChange">已处理</view>
  </view>

  <!-- 商品审核列表 -->
  <loading-state wx:if="{{tabIndex === 0 && prodLoading && products.length === 0}}" count="4" />
  <error-tip wx:elif="{{tabIndex === 0 && !prodLoading && prodError && products.length === 0}}" message="{{prodError}}" bind:retry="loadProducts" />
  <scroll-view wx:elif="{{tabIndex === 0 && products.length > 0}}" class="list-scroll" scroll-y bindscrolltolower="onProdScrollBottom">
    <view class="admin-card" wx:for="{{products}}" wx:key="id" bindtap="onTapProduct" data-id="{{item.id}}">
      <view class="card-row">
        <image wx:if="{{item.coverImage}}" class="card-thumb" src="{{item.coverImage}}" mode="aspectFill" />
        <view wx:else class="card-thumb-placeholder"></view>
        <view class="card-info">
          <view class="card-header">
            <text class="card-title">{{item.title}}</text>
            <text class="card-price">{{item.priceText}}</text>
          </view>
          <text class="card-sub">{{item.sellerName}}</text>
          <text class="card-desc">{{item.description || '暂无描述'}}</text>
        </view>
      </view>
      <view class="card-actions" catchtap>
        <button class="btn-approve" data-id="{{item.id}}" data-action="approved" bindtap="onReviewProduct">通过</button>
        <button class="btn-reject" data-id="{{item.id}}" data-action="rejected" bindtap="onReviewProduct">驳回</button>
      </view>
    </view>
    <loading-state wx:if="{{prodLoading && products.length > 0}}" count="1" />
  </scroll-view>
  <empty-state wx:elif="{{tabIndex === 0 && !prodLoading && !prodError}}" message="暂无待审核商品" />

  <!-- 举报审核筛选 -->
  <view wx:if="{{tabIndex === 1}}" class="filter-bar">
    <view class="filter-btn {{rptFilter === 'pending' ? 'filter-active' : ''}}" data-filter="pending" bindtap="onRptFilterChange">待处理</view>
    <view class="filter-btn {{rptFilter === 'handled' ? 'filter-active' : ''}}" data-filter="handled" bindtap="onRptFilterChange">已处理</view>
  </view>

  <!-- 举报审核列表 -->
  <loading-state wx:if="{{tabIndex === 1 && rptLoading && reports.length === 0}}" count="4" />
  <error-tip wx:elif="{{tabIndex === 1 && !rptLoading && rptError && reports.length === 0}}" message="{{rptError}}" bind:retry="loadReports" />
  <scroll-view wx:elif="{{tabIndex === 1 && reports.length > 0}}" class="list-scroll" scroll-y bindscrolltolower="onRptScrollBottom">
    <view class="admin-card" wx:for="{{reports}}" wx:key="id" wx:for-item="rpt" bindtap="onTapReportTarget" data-type="{{rpt.targetType}}" data-id="{{rpt.targetId}}">
      <!-- 被举报对象摘要 -->
      <view class="card-row">
        <image wx:if="{{rpt.targetImage}}" class="card-thumb" src="{{rpt.targetImage}}" mode="aspectFill" />
        <view wx:else class="card-thumb-placeholder"></view>
        <view class="card-info">
          <view class="card-header">
            <text class="card-title">{{rpt.targetTitle || ('目标 #' + rpt.targetId)}}</text>
            <text class="card-price">{{rpt.targetPrice || ''}}</text>
          </view>
          <text class="card-sub" wx:if="{{rpt.targetSeller}}">卖家: {{rpt.targetSeller}}</text>
          <text class="card-sub" wx:elif="{{rpt.targetScore}}">{{rpt.targetScore}}</text>
          <text class="card-desc">举报理由: {{rpt.reason}}</text>
        </view>
      </view>
      <!-- 举报元信息 -->
      <view class="rpt-meta">
        <text class="rpt-meta-text">{{rpt.targetTypeText}} · 举报 #{{rpt.id}}</text>
        <text class="rpt-meta-text" style="color:{{rpt.statusColor}}">{{rpt.statusText}}</text>
      </view>
      <view class="card-actions" catchtap>
        <button class="btn-approve" data-id="{{rpt.id}}" data-action="warning" bindtap="onHandleReport">警告</button>
        <button class="btn-approve" data-id="{{rpt.id}}" data-action="ban_user" bindtap="onHandleReport">封禁</button>
        <button class="btn-action" data-id="{{rpt.id}}" data-action="unlist_product" bindtap="onHandleReport">下架</button>
        <button class="btn-reject" data-id="{{rpt.id}}" data-action="reject" bindtap="onHandleReport">驳回</button>
      </view>
    </view>
    <loading-state wx:if="{{rptLoading && reports.length > 0}}" count="1" />
  </scroll-view>
  <empty-state wx:elif="{{tabIndex === 1 && !rptLoading && !rptError}}" message="暂无待处理举报" />

  <!-- ── 报表 ──────────────────────────────── -->
  <view wx:elif="{{tabIndex === 2}}" class="stats-section">
    <!-- 日期筛选 -->
    <view class="stats-date-bar">
      <input class="stats-date-input" type="text" placeholder="起始日期" value="{{statsDateStart}}" bindinput="onStatsDateStartInput" />
      <text class="stats-date-divider">至</text>
      <input class="stats-date-input" type="text" placeholder="结束日期" value="{{statsDateEnd}}" bindinput="onStatsDateEndInput" />
      <button class="stats-query-btn" size="mini" bindtap="loadStats">查询</button>
    </view>

    <loading-state wx:if="{{statsLoading}}" count="4" />

    <block wx:else>
      <!-- 总览卡片 -->
      <view wx:if="{{overview}}" class="stats-card">
        <view class="stats-card-title">平台总览</view>
        <view class="stats-overview-grid">
          <view class="stats-overview-item">
            <text class="stats-overview-num">{{overview.users}}</text>
            <text class="stats-overview-label">用户</text>
          </view>
          <view class="stats-overview-item">
            <text class="stats-overview-num">{{overview.products}}</text>
            <text class="stats-overview-label">商品</text>
          </view>
          <view class="stats-overview-item">
            <text class="stats-overview-num">{{overview.orders}}</text>
            <text class="stats-overview-label">订单</text>
          </view>
          <view class="stats-overview-item">
            <text class="stats-overview-num">{{overview.reports}}</text>
            <text class="stats-overview-label">举报</text>
          </view>
        </view>
      </view>

      <!-- 商品分布 -->
      <view wx:if="{{productStats}}" class="stats-card">
        <view class="stats-card-title">{{productStats.description}}（共 {{productStats.total}}）</view>
        <view class="stats-series-list">
          <view class="stats-series-item" wx:for="{{productStats.series}}" wx:key="label">
            <view class="stats-series-header">
              <text class="stats-series-label">{{item.label}}</text>
              <text class="stats-series-value">{{item.value}}（{{item.percentage}}%）</text>
            </view>
            <view class="stats-bar-track">
              <view class="stats-bar-fill" style="width:{{item.percentage}}%"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 交易分布 -->
      <view wx:if="{{tradeStats}}" class="stats-card">
        <view class="stats-card-title">{{tradeStats.description}}（共 {{tradeStats.total}}）</view>
        <view class="stats-series-list">
          <view class="stats-series-item" wx:for="{{tradeStats.series}}" wx:key="label">
            <view class="stats-series-header">
              <text class="stats-series-label">{{item.label}}</text>
              <text class="stats-series-value">{{item.value}}（{{item.percentage}}%）</text>
            </view>
            <view class="stats-bar-track">
              <view class="stats-bar-fill" style="width:{{item.percentage}}%"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 用户分布 -->
      <view wx:if="{{userStats}}" class="stats-card">
        <view class="stats-card-title">{{userStats.description}}（共 {{userStats.total}}）</view>
        <view class="stats-series-list">
          <view class="stats-series-item" wx:for="{{userStats.series}}" wx:key="label">
            <view class="stats-series-header">
              <text class="stats-series-label">{{item.label}}</text>
              <text class="stats-series-value">{{item.value}}（{{item.percentage}}%）</text>
            </view>
            <view class="stats-bar-track">
              <view class="stats-bar-fill" style="width:{{item.percentage}}%"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 每日趋势 -->
      <view wx:if="{{trendStats}}" class="stats-card">
        <view class="stats-card-title">每日趋势</view>
        <view class="stats-trend-section">
          <view class="stats-trend-group">
            <text class="stats-trend-group-title">📦 商品发布</text>
            <view class="stats-trend-list">
              <view class="stats-trend-item" wx:for="{{trendStats.productTrend}}" wx:key="date" wx:for-item="pt">
                <text class="stats-trend-date">{{pt.date}}</text>
                <text class="stats-trend-value">{{pt.value}}</text>
              </view>
            </view>
          </view>
          <view class="stats-trend-group">
            <text class="stats-trend-group-title">📋 成交订单</text>
            <view class="stats-trend-list">
              <view class="stats-trend-item" wx:for="{{trendStats.orderTrend}}" wx:key="date" wx:for-item="ot">
                <text class="stats-trend-date">{{ot.date}}</text>
                <text class="stats-trend-value">{{ot.value}}</text>
              </view>
            </view>
          </view>
          <view class="stats-trend-group">
            <text class="stats-trend-group-title">👤 用户注册</text>
            <view class="stats-trend-list">
              <view class="stats-trend-item" wx:for="{{trendStats.userTrend}}" wx:key="date" wx:for-item="ut">
                <text class="stats-trend-date">{{ut.date}}</text>
                <text class="stats-trend-value">{{ut.value}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 热门商品类别 -->
      <view wx:if="{{categoryStats}}" class="stats-card">
        <view class="stats-card-title">{{categoryStats.description}}（共 {{categoryStats.total}}）</view>
        <view class="stats-series-list">
          <view class="stats-series-item" wx:for="{{categoryStats.series}}" wx:key="label">
            <view class="stats-series-header">
              <text class="stats-series-label">{{item.label}}</text>
              <text class="stats-series-value">{{item.value}}（{{item.percentage}}%）</text>
            </view>
            <view class="stats-bar-track">
              <view class="stats-bar-fill" style="width:{{item.percentage}}%"></view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
