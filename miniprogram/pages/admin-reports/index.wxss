page {
  background: var(--color-bg);
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 状态筛选 tabs */
.filter-scroll {
  margin-bottom: 20rpx;
}

.filter-list {
  display: flex;
  gap: 12rpx;
}

.filter-tab {
  min-width: 120rpx;
  height: 60rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.filter-tab.active {
  color: #ffffff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* 举报列表 */
.report-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.report-card {
  padding: 22rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}

.report-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.report-type {
  padding: 8rpx 14rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
}

.report-status {
  font-size: 24rpx;
  font-weight: 700;
}

/* 举报对象卡片（商品/用户/订单） */
.target-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.target-image-wrap {
  width: 132rpx;
  height: 132rpx;
  overflow: hidden;
  background: #ededf2;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.target-image,
.target-image-placeholder {
  width: 100%;
  height: 100%;
}

.target-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.target-image-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.34;
}

.target-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.target-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.target-meta {
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.report-target {
  margin-bottom: 8rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.report-reporter {
  margin-bottom: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.report-reason {
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

/* 已处理信息 */
.handle-info {
  margin-top: 14rpx;
}

.handle-divider {
  height: 1rpx;
  background: var(--color-border);
  margin-bottom: 12rpx;
}

.handle-row {
  display: flex;
  margin-bottom: 6rpx;
}

.handle-label {
  color: var(--color-text-secondary);
  font-size: 23rpx;
  flex-shrink: 0;
}

.handle-value {
  color: var(--color-text);
  font-size: 23rpx;
}

/* 操作按钮行 */
.action-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.action-btn {
  height: 56rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
}

.action-reject {
  color: #8e8e93;
  border-color: #c7c7cc;
  background: #f9f9f9;
}

.action-warning {
  color: #f0ad4e;
  border-color: #f0ad4e;
  background: #fff8f0;
}

.action-unlist_product {
  color: #d9534f;
  border-color: #d9534f;
  background: #fff5f5;
}

.action-ban_user {
  color: #ffffff;
  border-color: #d9534f;
  background: #d9534f;
}

/* 底部加载提示 */
.bottom-tip {
  padding: 28rpx 0 40rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}
