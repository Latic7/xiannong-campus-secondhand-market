page {
  background: var(--color-bg);
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 商品列表 */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.product-card {
  padding: 22rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}

.card-top {
  display: flex;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.product-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f2f2f7;
}

.product-thumb-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  width: 50rpx;
  height: 50rpx;
  opacity: 0.3;
}

.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.product-price {
  color: #d9534f;
  font-size: 28rpx;
  font-weight: 800;
}

.product-category {
  padding: 4rpx 12rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
}

.product-owner {
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

/* 描述 */
.card-desc {
  margin-bottom: 14rpx;
  padding: 14rpx;
  background: #f9f9fb;
  border-radius: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* 底部 */
.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.product-time {
  color: #999;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* 操作按钮行 */
.action-row {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  height: 56rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: 1rpx solid;
}

.action-approve {
  color: #ffffff;
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.action-reject {
  color: #d9534f;
  border-color: #d9534f;
  background: #fff5f5;
}

/* 底部加载提示 */
.bottom-tip {
  padding: 28rpx 0 40rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}
