page {
  background: var(--color-bg);
}

.page-body {
  padding: 20rpx 24rpx 60rpx;
}

/* ── 分区卡片 ─────────────────────────────── */
.section {
  margin-bottom: 20rpx;
  padding: 26rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  position: relative;
  padding-left: 18rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 6rpx;
  height: 22rpx;
  background: var(--color-brand-gold);
  border-radius: 999rpx;
}

/* ── 表单字段 ─────────────────────────────── */
.field-group {
  margin-bottom: 24rpx;
}

.field-group-last {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
}

.field-counter {
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  font-weight: 400;
}

.input-field {
  width: 100%;
  height: 82rpx;
  padding: 0 20rpx;
  color: var(--color-text);
  font-size: 28rpx;
  background: #f2f2f7;
  border-radius: 18rpx;
  box-sizing: border-box;
}

/* ── 保存按钮 ─────────────────────────────── */
.save-section {
  padding: 20rpx 0;
}

.save-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  background: var(--color-primary);
  border-radius: 26rpx;
  border: none;
}

.save-btn[disabled] {
  opacity: 0.5;
}
