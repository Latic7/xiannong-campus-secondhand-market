/* ── 页面容器 ──────────────────────────────── */
page { background: #f5f5f5; }
.page-body { min-height: 100vh; }

/* ── 头部区域 ──────────────────────────────── */
.user-header { position: relative; overflow: hidden; }
.header-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 280rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #7c3aed 50%, #a78bfa 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.user-card {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 24rpx;
  margin: 60rpx 28rpx 0; padding: 32rpx 28rpx;
  background: #fff; border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(79,70,229,0.15);
}

/* 头像 */
.avatar-section {
  position: relative; width: 120rpx; height: 120rpx;
  flex-shrink: 0;
}
.user-avatar {
  width: 100%; height: 100%; border-radius: 50%;
  border: 4rpx solid #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}
.avatar-placeholder {
  width: 100%; height: 100%; border-radius: 50%;
  background: #eef2ff; display: flex; align-items: center;
  justify-content: center;
}
.avatar-icon { font-size: 56rpx; }

/* 用户信息 */
.user-info { flex: 1; min-width: 0; }
.info-logged-in { display: flex; flex-direction: column; gap: 8rpx; }
.user-nickname { font-size: 34rpx; font-weight: 700; color: #1a1a1a; }
.reputation-row { display: flex; align-items: center; gap: 6rpx; }
.reputation-star { font-size: 24rpx; }
.reputation-score { font-size: 26rpx; font-weight: 600; }
.reputation-label { font-size: 24rpx; }

.info-logged-out { display: flex; flex-direction: column; gap: 6rpx; }
.login-prompt { font-size: 34rpx; font-weight: 600; color: #1a1a1a; }
.login-hint { font-size: 24rpx; color: #999; }

/* 退出按钮 */
.logout-btn {
  flex-shrink: 0; padding: 8rpx 24rpx;
  font-size: 24rpx; color: #999; border: 1rpx solid #e5e5e5;
  border-radius: 24rpx;
}

/* ── 数据统计 ──────────────────────────────── */
.stats-section {
  display: flex; align-items: center; justify-content: space-around;
  margin: 24rpx 28rpx; padding: 28rpx 0;
  background: #fff; border-radius: 16rpx;
}
.stat-item {
  display: flex; flex-direction: column; align-items: center;
  gap: 8rpx; flex: 1;
}
.stat-num { font-size: 40rpx; font-weight: 700; color: #1a1a1a; }
.stat-label { font-size: 24rpx; color: #999; }
.stat-divider {
  width: 1rpx; height: 48rpx; background: #eee;
}

/* ── 菜单区 ────────────────────────────────── */
.menu-section { margin: 0 28rpx 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.menu-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 28rpx; border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-left { display: flex; align-items: center; gap: 20rpx; }
.menu-icon { font-size: 36rpx; }
.menu-text { font-size: 28rpx; color: #1a1a1a; }
.menu-arrow { font-size: 32rpx; color: #ccc; }

/* ── 底部留白 ──────────────────────────────── */
.bottom-spacer { height: 60rpx; }
