page {
  background: var(--color-bg);
}

.page-body {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: var(--color-bg);
}

.user-header {
  padding: 28rpx 24rpx 0;
}

.header-bg {
  display: none;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 30rpx;
  box-sizing: border-box;
  border-top: 6rpx solid rgba(11, 107, 67, 0.18);
}

.avatar-section {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
}

.user-avatar,
.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-avatar {
  background: #ededf2;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f2f7;
}

.avatar-icon-img {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.42;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.info-logged-in,
.info-logged-out {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-nickname,
.login-prompt {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-hint {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.reputation-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 32rpx;
  line-height: 32rpx;
}

.reputation-star-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  display: block;
}

.reputation-score {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.reputation-label {
  font-size: 24rpx;
  line-height: 32rpx;
}

.logout-btn {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  background: #f2f2f7;
  border-radius: 999rpx;
}

.stats-section {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 20rpx 24rpx;
  padding: 24rpx 0;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
}

.stat-num {
  color: var(--color-primary);
  font-size: 38rpx;
  font-weight: 800;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-label {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: var(--color-border);
}

.menu-section {
  margin: 0 24rpx 20rpx;
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 26rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.menu-icon-img {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  opacity: 0.54;
}

.menu-text {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 500;
}

.menu-arrow {
  color: var(--color-text-tertiary);
  font-size: 34rpx;
}

.bottom-spacer {
  height: 40rpx;
}
