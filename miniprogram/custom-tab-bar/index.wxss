.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  height: 118rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(60, 60, 67, 0.16);
  backdrop-filter: blur(24rpx);
  box-sizing: content-box;
}

.tab-bar-wrapper {
  height: 100rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.tab-item {
  flex: 1;
  height: 100%;
  padding-bottom: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.tab-item:active {
  transform: scale(0.94);
  opacity: 0.78;
}

.tab-item.middle {
  position: relative;
  flex: 1.08;
}

.tab-icon-wrap {
  position: relative;
  display: inline-flex;
  margin-bottom: 4rpx;
}

.tab-icon-img {
  width: 46rpx;
  height: 46rpx;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  background: #ff3b30;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.tab-badge-text {
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.tab-text {
  color: #86868b;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: #0b6b43;
  font-weight: 600;
}

.middle-btn {
  position: absolute;
  top: -18rpx;
  left: 50%;
  width: 86rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0b6b43;
  border: 6rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-shadow: 0 12rpx 28rpx rgba(11, 107, 67, 0.24);
  transform: translateX(-50%);
  box-sizing: border-box;
}

.middle-btn:active {
  transform: translateX(-50%) scale(0.94);
}

.middle-btn-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.middle-btn-icon {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.middle-text {
  margin-top: 48rpx;
}
