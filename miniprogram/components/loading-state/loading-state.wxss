/* 骨架屏容器 */
.loading-container {
  padding: 20rpx 0;
}

/* 骨架列表 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 骨架卡片 */
.skeleton-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  gap: 20rpx;
}

/* 骨架图片占位 */
.skeleton-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  flex-shrink: 0;
}

/* 骨架内容区 */
.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
}

/* 骨架标题 */
.skeleton-title {
  height: 36rpx;
  width: 70%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* 骨架描述 */
.skeleton-desc {
  height: 28rpx;
  width: 90%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  animation-delay: 0.1s;
}

/* 骨架底部 */
.skeleton-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.skeleton-price {
  height: 32rpx;
  width: 120rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  animation-delay: 0.2s;
}

.skeleton-tag {
  height: 28rpx;
  width: 80rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  animation-delay: 0.3s;
}

/* Shimmer 闪光动画 */
@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 加载提示文字 */
.loading-message {
  display: block;
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  margin-top: 24rpx;
}
