/* Error tip placeholder styles */
 .error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 44rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(60, 60, 67, 0.16);
  border-radius: 24rpx;
}

.error-icon-img {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.72;
}

.error-message {
  color: #3a3a3c;
  font-size: 26rpx;
}

.error-button {
  min-width: 200rpx;
  height: 72rpx;
  margin: 0;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
  background: #0B6B43;
  border-radius: 18rpx;
}
